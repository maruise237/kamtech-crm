# ============================================================
# OBLIGATOIRE - l application ne demarre pas sans ces valeurs.
# ============================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cle service-role Supabase. Elle contourne RLS et ne doit etre utilisee
# que cote serveur (webhook et moteur d automatisation). Gardez-la secrete.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chiffrement des jetons WhatsApp (64 caracteres hex = 32 octets).
# Generation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changer cette valeur rend les anciens jetons illisibles.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Secret de l application Meta (Meta for Developers -> App Settings -> Basic).
# Verifie la signature HMAC-SHA256 de chaque webhook entrant.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMANDE
# ============================================================

# URL publique canonique du deploiement, sans slash final.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# ============================================================
# FACULTATIF
# ============================================================

# Secret protegeant GET /api/automations/cron.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string